+async def museguide_speak(request):
+    """MuseGuide integration: switch state avatar, then speak supplied LLM text."""
+    try:
+        params: dict = await request.json()
+        sessionid: str = params.get('sessionid', '')
+        avatar_session = get_session(request, sessionid)
+        if avatar_session is None:
+            return json_error("session not found")
+
+        text = str(params.get("text", "")).strip()
+        if not text:
+            return json_error("text is required")
+
+        if params.get("interrupt", True):
+            avatar_session.flush_talk()
+
+        state_info = _switch_museguide_avatar(
+            request,
+            avatar_session,
+            params.get("persona_id", "woman_demo"),
+            params.get("video_state", "IDLE"),
+        )
+
+        datainfo = {}
+        if params.get("tts"):
+            datainfo["tts"] = params.get("tts")
+
+        avatar_session.put_msg_txt(text, datainfo)
+        return json_ok({
+            "sessionid": sessionid,
+            "video_state": _normalize_museguide_state(params.get("video_state", "IDLE")),
+            **state_info,
+        })
+    except Exception as e:
+        logger.exception('museguide_speak exception:')
+        return json_error(str(e))
+
