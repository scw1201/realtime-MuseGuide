+MUSEGUIDE_ALLOWED_STATES = {
+    "IDLE",
+    "LISTENING",
+    "GREETING_SELF",
+    "EXPLAIN_DETAILED",
+    "POINTING_DIRECTION",
+    "FOCUS_EXHIBIT",
+}
+
+
+def _normalize_museguide_state(value: str) -> str:
+    state = str(value or "").strip().upper()
+    return state if state in MUSEGUIDE_ALLOWED_STATES else "IDLE"
+
+
+def _live_avatar_state(persona_id: str, video_state: str) -> str:
+    state = _normalize_museguide_state(video_state)
+    if str(persona_id or "").strip() == "woman_demo":
+        if state == "GREETING_SELF":
+            return "GREETING_SELF"
+        if state == "IDLE" or state == "LISTENING":
+            return "IDLE"
+        return "FOCUS_EXHIBIT"
+    return state
+
+
+def _museguide_avatar_candidates(persona_id: str, video_state: str) -> list[str]:
+    persona = str(persona_id or "woman_demo").strip() or "woman_demo"
+    state = _live_avatar_state(persona, video_state)
+    return [
+        f"{persona}_{state}",
+        f"{persona}_IDLE",
+    ]
+
+
+def _apply_avatar_payload(avatar_session, model_name: str, payload) -> None:
+    if model_name == "wav2lip":
+        (
+            avatar_session.frame_list_cycle,
+            avatar_session.face_list_cycle,
+            avatar_session.coord_list_cycle,
+        ) = payload
+        return
+    if model_name == "musetalk":
+        (
+            avatar_session.frame_list_cycle,
+            avatar_session.mask_list_cycle,
+            avatar_session.coord_list_cycle,
+            avatar_session.mask_coords_list_cycle,
+            avatar_session.input_latent_list_cycle,
+        ) = payload
+        return
+    raise ValueError(f"Unsupported MuseGuide live model: {model_name}")
+
+
+def _switch_museguide_avatar(request, avatar_session, persona_id: str, video_state: str) -> dict:
+    model_name = request.app.get("museguide_model", "")
+    default_avatar_id = request.app.get("museguide_default_avatar_id", "")
+    global_avatars = request.app.get("museguide_global_avatars", {})
+    load_avatar = request.app.get("museguide_load_avatar")
+    attempted = []
+
+    for avatar_id in _museguide_avatar_candidates(persona_id, video_state):
+        attempted.append(avatar_id)
+        try:
+            if avatar_id not in global_avatars:
+                if load_avatar is None:
+                    raise RuntimeError("LiveTalking load_avatar is not configured")
+                global_avatars[avatar_id] = load_avatar(avatar_id)
+            _apply_avatar_payload(avatar_session, model_name, global_avatars[avatar_id])
+            avatar_session.current_avatar_id = avatar_id
+            if hasattr(avatar_session, "init_customindex"):
+                avatar_session.init_customindex()
+            return {
+                "avatar_id": avatar_id,
+                "fallback": avatar_id != attempted[0],
+                "attempted": attempted,
+            }
+        except Exception as exc:
+            logger.warning("MuseGuide avatar switch failed: %s -> %s", avatar_id, exc)
+
+    if default_avatar_id and default_avatar_id in global_avatars:
+        _apply_avatar_payload(avatar_session, model_name, global_avatars[default_avatar_id])
+        avatar_session.current_avatar_id = default_avatar_id
+        return {
+            "avatar_id": default_avatar_id,
+            "fallback": True,
+            "attempted": attempted + [default_avatar_id],
+        }
+
+    raise RuntimeError(f"No usable MuseGuide avatar found. attempted={attempted}")
+
+
