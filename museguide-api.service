[Unit]
Description=MuseGuide FastAPI
After=network.target museguide-asr.service museguide-tts.service
Wants=museguide-asr.service museguide-tts.service

[Service]
Type=simple
WorkingDirectory=/media/lenovo/aigo/data/my_museguide
ExecStart=/bin/zsh -lc 'set -a; source /media/lenovo/aigo/data/my_museguide/.env >/dev/null 2>&1 || true; set +a; export MUSEGUIDE_ASR_UPSTREAM=ws://127.0.0.1:9001; export MUSEGUIDE_TTS_UPSTREAM=ws://127.0.0.1:8765; exec /media/lenovo/aigo/data/my_museguide/.conda/bin/conda run --no-capture-output -p /media/lenovo/aigo/data/my_museguide/.conda/envs/museguide python -m uvicorn museguide.api.server:app --host 0.0.0.0 --port 8000'
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
