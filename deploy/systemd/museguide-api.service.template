[Unit]
Description=MuseGuide FastAPI
After=network.target museguide-asr.service museguide-tts.service
Wants=museguide-asr.service museguide-tts.service

[Service]
Type=simple
WorkingDirectory={{REMOTE_DIR}}
ExecStart=/bin/bash -lc 'set -a; source {{REMOTE_DIR}}/.env >/dev/null 2>&1 || true; set +a; export MUSEGUIDE_ASR_UPSTREAM=ws://127.0.0.1:{{ASR_PORT}}; export MUSEGUIDE_TTS_UPSTREAM=ws://127.0.0.1:{{TTS_PORT}}; exec {{REMOTE_DIR}}/.conda/bin/conda run --no-capture-output -p {{REMOTE_DIR}}/.conda/envs/museguide python -m uvicorn museguide.api.server:app --host 0.0.0.0 --port {{API_PORT}}'
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
