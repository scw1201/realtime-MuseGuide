[Unit]
Description=MuseGuide ASR WebSocket
After=network.target

[Service]
Type=simple
WorkingDirectory=/media/lenovo/aigo/data/my_museguide
EnvironmentFile=/media/lenovo/aigo/data/my_museguide/.env
ExecStart=/media/lenovo/aigo/data/my_museguide/.conda/bin/conda run --no-capture-output -p /media/lenovo/aigo/data/my_museguide/.conda/envs/museguide python -m museguide.asr.ws_server
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
