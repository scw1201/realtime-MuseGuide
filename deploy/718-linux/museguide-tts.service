[Unit]
Description=MuseGuide TTS WebSocket
After=network.target

[Service]
Type=simple
WorkingDirectory=/media/lenovo/aigo/data/my_museguide
ExecStart=/bin/zsh -lc 'set -a; source /media/lenovo/aigo/data/my_museguide/.env >/dev/null 2>&1 || true; set +a; export TTS_WORKER_HOST=127.0.0.1; export TTS_WORKER_PORT=8765; exec /media/lenovo/aigo/data/my_museguide/.conda/bin/conda run --no-capture-output -p /media/lenovo/aigo/data/my_museguide/.conda/envs/museguide python -m museguide.tts.worker_v3'
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
